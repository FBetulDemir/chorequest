rules_version = '2';

// ChoreQuest Firestore security rules. DRAFT, NOT DEPLOYED YET.
//
// These are written to work with both the current code and the version that is
// already deployed on Vercel, so existing accounts and data keep working.
//
// Before deploying:
//   1. Copy your current rules from the Firebase console (Firestore → Rules) as a backup.
//   2. Test with the emulator:  npx firebase emulators:start --only firestore
//   3. Deploy:                  npx firebase deploy --only firestore:rules --project chore-quest-22419
//
// Joining: invite codes live in inviteCodes/{CODE}, which can be fetched by exact
// code but never listed. A non-member can only add themselves to a household by
// presenting a code that belongs to it.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function householdDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid));
    }

    function isMemberOf(householdData) {
      return signedIn() && householdData.get('members', {}).get(me(), false) == true;
    }

    function isMember(hid) {
      return isMemberOf(householdDoc(hid).data);
    }

    function myHouseholdId() {
      return get(/databases/$(database)/documents/users/$(me())).data.get('householdId', null);
    }

    // ---------- Users ----------
    match /users/{uid} {
      // Your own profile, or profiles of people in your household (for names)
      allow read: if signedIn() && (
        uid == me() ||
        (resource.data.get('householdId', null) != null
          && resource.data.get('householdId', null) == myHouseholdId())
      );

      allow create: if signedIn()
        && uid == me()
        && request.resource.data.uid == me()
        && request.resource.data.householdId == null;

      // You can only point your profile at a household you are a member of (or none)
      allow update: if signedIn()
        && uid == me()
        && request.resource.data.get('uid', null) == resource.data.get('uid', null)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['householdId'])
          || request.resource.data.householdId == null
          || isMember(request.resource.data.householdId)
        );

      allow delete: if signedIn() && uid == me();

      // Push notification tokens for this user's devices
      match /pushTokens/{token} {
        allow read, write: if signedIn() && uid == me();
      }
    }

    // ---------- Invite codes ----------
    match /inviteCodes/{code} {
      // Look up by exact code only; listing would reveal every household
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.size() >= 6 && code.size() <= 10
        && request.resource.data.householdId is string
        && request.resource.data.createdBy == me()
        && isMember(request.resource.data.householdId);

      // Codes are never reassigned; members can retire their household's code
      allow update: if false;
      allow delete: if signedIn() && isMember(resource.data.householdId);
    }

    // ---------- Households ----------
    match /households/{hid} {
      allow get: if isMemberOf(resource.data);
      allow list: if false;

      // The creator must be the only member; Plus can only be granted by the server
      allow create: if signedIn()
        && request.resource.data.members.keys().hasOnly([me()])
        && request.resource.data.members[me()] == true
        && !('plan' in request.resource.data);

      allow update: if signedIn() && (
        // Members can edit household details; membership changes only for themselves
        (
          isMemberOf(resource.data)
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()])
          // `plan` is written by the RevenueCat webhook only
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan'])
        )
        ||
        // Joining: a non-member may add only themselves, with a valid invite code
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt', 'lastJoinCode'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()])
          && request.resource.data.members[me()] == true
          && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.lastJoinCode)).data.householdId == hid
        )
      );

      allow delete: if false;

      // ---------- Chore templates ----------
      match /choreTemplates/{templateId} {
        function validChore(d) {
          return d.title is string && d.title.size() > 0 && d.title.size() <= 120
            && (!('icon' in d) || (d.icon is string && d.icon.size() <= 16))
            && d.points is number && d.points >= 0 && d.points <= 100
            && d.frequency in ['daily', 'weekly', 'monthly', 'seasonal']
            && d.assigneeMode in ['anyone', 'fixed', 'rotating'];
        }

        allow read: if isMember(hid);
        allow create, update: if isMember(hid) && validChore(request.resource.data);
        allow delete: if isMember(hid);
      }

      // ---------- Points ledger (append-only) ----------
      match /ledger/{entryId} {
        allow read: if isMember(hid);

        // You can only record points for yourself, within a sane range
        allow create: if isMember(hid)
          && request.resource.data.actorUid == me()
          && request.resource.data.delta is number
          && math.abs(request.resource.data.delta) <= 100
          && request.resource.data.reason is string
          && request.resource.data.createdAt is number;

        // History can't be rewritten; corrections are new "undo" entries
        allow update, delete: if false;
      }

      // ---------- Rewards shop ----------
      match /rewards/{rewardId} {
        function validReward(d) {
          return d.title is string && d.title.size() > 0 && d.title.size() <= 60
            && d.icon is string && d.icon.size() <= 16
            && d.cost is number && d.cost > 0 && d.cost <= 100000;
        }

        allow read: if isMember(hid);
        allow create, update: if isMember(hid) && validReward(request.resource.data);
        allow delete: if isMember(hid);
      }

      match /redemptions/{redemptionId} {
        allow read: if isMember(hid);

        // Members redeem for themselves; the app checks the coin balance
        allow create: if isMember(hid)
          && request.resource.data.uid == me()
          && request.resource.data.status == 'pending'
          && request.resource.data.cost is number
          && request.resource.data.cost > 0;

        // Anyone in the household can mark a reward as delivered
        allow update: if isMember(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'fulfilledBy', 'fulfilledAt'])
          && request.resource.data.status == 'fulfilled';

        // Cancelling your own undelivered redemption refunds the coins
        allow delete: if isMember(hid)
          && resource.data.uid == me()
          && resource.data.status == 'pending';
      }
    }
  }
}
