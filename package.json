{
  "name": "chorequest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:mobile": "cross-env MOBILE_BUILD=1 next build && cap sync",
    "ios": "npm run build:mobile && cap open ios",
    "android": "npm run build:mobile && cap open android",
    "assets:native": "node scripts/generate-native-assets.js && capacitor-assets generate --ios --android --iconBackgroundColor #8b5cf6 --iconBackgroundColorDark #0f0b1a --splashBackgroundColor #8b5cf6 --splashBackgroundColorDark #0f0b1a",
    "test:rules": "firebase emulators:exec --only firestore --project demo-chorequest \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-social-login": "^7.20.0",
    "@revenuecat/purchases-capacitor": "^11.3.3",
    "clsx": "^2.1.1",
    "firebase": "^12.8.0",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.1.6",
    "next": "16.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
